[Unit]
Description=nodeguard geoip enrichment of blocked sources (fail-open, read-only on the maps)
After=nodeguard-maps.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nodeguard-geo
# NOTE: Type=oneshot defaults to an infinite start timeout, so a hung
# enrichment would stop the timer firing rather than fail. Sized inside
# the 5-minute timer period.
TimeoutStartSec=4min
# Hardening (evaluation finding S2). ProtectSystem=strict leaves /dev,
# /proc, and /sys writable, so the bpffs pin directory keeps working; it
# is listed anyway as documentation and against a semantics change.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# NOTE: the "-" prefix is mandatory, not style. The pin directory is
# bpffs: it is gone after every reboot and recreated at runtime by
# nodeguard-maps, and an unprefixed ReadWritePaths entry naming a path
# that does not exist yet fails the unit at namespace setup
# (status 226/NAMESPACE) before ExecStart ever runs.
ReadWritePaths=/run/nodeguard /var/lib/nodeguard -/sys/fs/bpf/nodeguard
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF
# NOTE: bpf(2) sits in systemd's @privileged group, not @system-service,
# so the read-only block-map dump still needs it named explicitly.
SystemCallFilter=@system-service bpf
