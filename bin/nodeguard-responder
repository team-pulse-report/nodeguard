#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""nodeguard-responder: the Suricata-to-XDP IPS wiring.

Tails eve.json and, for alerts that pass EVERY gate below, inserts the
offender source address into the pinned block map via nodeguard-block:

INVARIANT: the seven gates below, and their order, are a contract with
handle_event() further down this file; adding, removing, or reordering a
gate must update both.
  1. event_type == alert
  2. severity 1, or SID opted in via sids.conf ("block <sid>")
  3. SID not denied ("ignore <sid>")
  4. anti-spoofing: proto TCP with flow.pkts_toclient >= 1 and
     flow.pkts_toserver >= 2; UDP/ICMP only for SIDs promoted by hand
     ("udp-ok <sid>") with a written justification in sids.conf
  5. inbound: dest_ip in HOME_NETS, src_ip globally routable
  6. src not covered by the live allow maps (cached, refreshed on a short
     TTL; an unreadable cache fails toward NOT blocking)
  7. rate caps on new-block ATTEMPTS (30/min, 500 distinct/hour default),
     accounted identically in dry-run and enforce mode

TTL escalation counts OFFENSES (block windows), not alert lines: while a
source is inside its blocked_until window, further alerts refresh
last_seen only. Windows belong to the boot they were written under and
load as expired under any other one, because the kernel's blocks do not
survive a reboot. Dry-run (ENFORCE=no, the mandatory first-run mode) logs
WOULD BLOCK and simulates the same windows so the shadow stream is an
accurate rehearsal of enforcement. Stdlib only; stdout goes to journald.
"""

import collections
import ipaddress
import json
import os
import subprocess
import sys
import time

CONF = "/etc/nodeguard/responder.conf"
RESP_KV = "/run/nodeguard/responder.kv"
NGMAP = "/usr/local/lib/nodeguard/ngmap.py"
BLOCK = "/usr/local/sbin/nodeguard-block"
ALLOW_CACHE_TTL = 60
BOOT_ID_PATH = "/proc/sys/kernel/random/boot_id"

# INVARIANT: reserved top-level journal key, never an address. Journal
# record keys are IP address strings, so this cannot collide with one.
JOURNAL_META_KEY = "_meta"


def log(msg):
    """Print a line to stdout and flush immediately so journald captures it in order."""
    print(msg, flush=True)


def boot_id():
    """Return the kernel's current boot id, empty when it cannot be read.
    SAFETY: an unreadable boot id compares unequal to any journaled one,
    because save() stamps no boot id at all when this returns empty; so
    windows load as expired even when both ends failed to read it. That
    fails toward one redundant block of an address the kernel may already
    cover, never toward suppressing a block the kernel is not
    enforcing."""
    try:
        with open(BOOT_ID_PATH) as f:
            return f.read().strip()
    except OSError:
        return ""


def load_conf():
    """Load and validate responder.conf, parsing HOME_NETS into networks and exiting fatally if it is empty or malformed."""
    conf = {
        "ENFORCE": "no",
        "EVE": "/var/log/suricata/eve.json",
        "JOURNAL": "/var/lib/nodeguard/blocks.json",
        "SIDS": "/etc/nodeguard/sids.conf",
        "TTL": "3600",
        "TTL_MAX": "86400",
        "RATE_MIN": "30",
        "RATE_HOUR": "500",
        "HOME_NETS": "",
    }
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except FileNotFoundError:
        log(f"responder: {CONF} missing, using defaults (ENFORCE=no)")
    nets = []
    for n in conf["HOME_NETS"].split(","):
        n = n.strip()
        if not n:
            continue
        try:
            net = ipaddress.ip_network(n, strict=False)
        except ValueError as e:
            log(f"responder: FATAL: HOME_NETS entry not a valid CIDR: {n} ({e})")
            sys.exit(2)
        if str(net) != n:
            log(f"responder: HOME_NETS entry {n} normalized to {net}")
        nets.append(net)
    conf["HOME_NETS"] = nets
    if not conf["HOME_NETS"]:
        log("responder: FATAL: HOME_NETS is empty in responder.conf")
        sys.exit(2)
    return conf


def load_sids(path):
    """Parse sids.conf into the opt-in, ignore, and udp-ok SID sets that tune which alerts qualify for a block."""
    optin, ignore, udp_ok = set(), set(), set()
    try:
        with open(path) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                parts = line.split()
                if len(parts) != 2 or not parts[1].isdigit():
                    log(f"responder: sids.conf: skipping malformed line: {line}")
                    continue
                kind, sid = parts[0], int(parts[1])
                if kind == "block":
                    optin.add(sid)
                elif kind == "ignore":
                    ignore.add(sid)
                elif kind == "udp-ok":
                    udp_ok.add(sid)
                else:
                    log(f"responder: sids.conf: unknown directive {kind}")
    except FileNotFoundError:
        pass
    return optin, ignore, udp_ok


class AllowCache:
    """Snapshot of the live allow maps, refreshed on a short TTL.
    SAFETY: the kernel allow map is the backstop; an unreadable cache
    fails toward NOT blocking."""

    def __init__(self):
        """Start with an empty, unfetched allow-map cache."""
        self.nets = None
        self.fetched = 0.0

    def protected(self, ip_str):
        """Report whether an address is covered by the live allow maps, refreshing the cache on its TTL.
        True if protected, False if blockable, None if undeterminable."""
        now = time.monotonic()
        if self.nets is None or now - self.fetched > ALLOW_CACHE_TTL:
            try:
                r = subprocess.run(
                    ["python3", NGMAP, "allow-dump"],
                    capture_output=True, text=True, timeout=30)
                if r.returncode != 0:
                    raise RuntimeError(r.stderr.strip())
                self.nets = [ipaddress.ip_network(n)
                             for n in json.loads(r.stdout)]
                self.fetched = now
            except Exception as e:
                log(f"responder: allow-dump failed ({e}); "
                    "failing toward NOT blocking")
                self.nets = None
                return None
        ip = ipaddress.ip_address(ip_str)
        return any(ip in n for n in self.nets
                   if n.version == ip.version)


class Journal:
    """Per-IP offense history.
    SAFETY: count increments only on a completed block window (drives the
    TTL exponent), and shadow_hits only on a non-offense observation
    (dry-run sighting, rate-capped repeat); conflating the two would
    escalate TTL on mere observations. blocked_until = wall clock end of
    the current (real or shadow) window.
    SAFETY: windows are scoped to the boot they were written under. The
    block maps live on bpffs and their CLOCK_MONOTONIC expiries reset at
    reboot (ADR 0003), so a window carried across a reboot would suppress
    re-blocking (handle_event's window check) on behalf of a kernel entry
    that no longer exists; the longest-escalated attackers carry the
    longest windows and would get the longest free pass."""

    def __init__(self, path):
        """Load the per-IP offense journal from disk, quarantining a corrupt file and starting fresh rather than crashing."""
        self.path = path
        self.boot = boot_id()
        self.data = {}
        meta = None
        try:
            with open(path) as f:
                raw = json.load(f)
            if isinstance(raw, dict):
                # Popped BEFORE the record filter, so the reserved record
                # can never be read back as an address.
                meta = raw.pop(JOURNAL_META_KEY, None)
                self.data = {ip: rec for ip, rec in raw.items()
                             if isinstance(rec, dict)}
            else:
                raise ValueError("journal root is not an object")
        except FileNotFoundError:
            pass
        except (json.JSONDecodeError, ValueError) as e:
            bad = path + ".corrupt"
            try:
                os.replace(path, bad)
                log(f"responder: journal unreadable ({e}); "
                    f"moved to {bad}, starting fresh")
            except OSError:
                log(f"responder: journal unreadable ({e}); starting fresh")
            self.data = {}
        if not isinstance(meta, dict) or meta.get("boot_id") != self.boot:
            self.expire_windows()
        self.prune()

    def expire_windows(self):
        """Treat every persisted block window as over, keeping the offense
        history that drives escalation (count, shadow_hits, first_seen,
        last_seen, sid) so a repeat offender's re-block still lands with
        its escalated TTL."""
        stale = 0
        for rec in self.data.values():
            if rec.get("blocked_until", 0):
                stale += 1
            rec["blocked_until"] = 0
        if stale:
            log(f"responder: journal written under another boot; {stale} "
                "block windows treated as expired (offense counts kept)")

    def prune(self):
        """Drop journal records not seen in 30 days and persist, keeping the file bounded."""
        cutoff = time.time() - 30 * 86400
        self.data = {ip: rec for ip, rec in self.data.items()
                     if rec.get("last_seen", 0) >= cutoff}
        self.save()

    def save(self):
        """Persist the journal to disk atomically (temp file then rename),
        stamped with the boot id its windows belong to."""
        tmp = self.path + ".tmp"
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        payload = dict(self.data)
        # SAFETY: stamp only a boot id that was actually read. An empty
        # stamp would compare EQUAL to an equally unreadable boot id at
        # the next load and carry windows across a reboot, which is the
        # suppression this scoping exists to remove; an absent stamp
        # loads as prior-boot and expires them.
        if self.boot:
            payload[JOURNAL_META_KEY] = {"boot_id": self.boot}
        with open(tmp, "w") as f:
            json.dump(payload, f)
        os.replace(tmp, self.path)

    def _rec(self, ip):
        """Return (creating if needed) the mutable journal record for one IP."""
        return self.data.setdefault(
            ip, {"count": 0, "shadow_hits": 0, "blocked_until": 0,
                 "first_seen": time.time()})

    def sighting(self, ip, sid):
        """A non-offense observation (refresh, rate-capped, dry-run)."""
        rec = self._rec(ip)
        rec["last_seen"] = time.time()
        rec["sid"] = sid
        rec["shadow_hits"] = rec.get("shadow_hits", 0) + 1
        self.save()
        return rec

    def offense(self, ip, sid, ttl, shadow):
        """A new block window (real, or simulated in dry-run)."""
        rec = self._rec(ip)
        rec["last_seen"] = time.time()
        rec["sid"] = sid
        rec["blocked_until"] = time.time() + ttl
        if shadow:
            rec["shadow_hits"] = rec.get("shadow_hits", 0) + 1
        else:
            rec["count"] = rec.get("count", 0) + 1
        self.save()
        return rec


def follow(path):
    """tail -F: follow across rotation.
    SAFETY: seeks to END only on the FIRST open (a daemon restart never
    replays); every reopen after a rotation or truncation starts at
    offset 0, and the old fd is drained to EOF first so lines appended
    between the last read and the rotation check are not lost."""
    f = None
    inode = None
    first_open = True
    while True:
        if f is None:
            try:
                f = open(path)
                inode = os.fstat(f.fileno()).st_ino
                if first_open:
                    f.seek(0, os.SEEK_END)
                    first_open = False
                log(f"responder: following {path} (inode {inode})")
            except FileNotFoundError:
                time.sleep(2)
                continue
        line = f.readline()
        if line:
            yield line
            continue
        try:
            st = os.stat(path)
        except FileNotFoundError:
            st = None
        if st is None or st.st_ino != inode or st.st_size < f.tell():
            for line in f:  # drain stragglers from the rotated-away file
                yield line
            f.close()
            f = None
            continue
        time.sleep(0.5)
        yield None  # idle sentinel: lets the caller flush pending state


def block_via_wrapper(src, ttl):
    """Insert one block through the nodeguard-block wrapper, returning
    (returncode, stderr). The responder's only enforcement write, behind
    one name so a test can record the call instead of running it."""
    r = subprocess.run([BLOCK, src, str(ttl)], capture_output=True, text=True)
    return r.returncode, r.stderr.strip()


class EventState:
    """Everything handling one event reads or mutates: the config-derived
    limits, the SID sets, the offense journal, the allow cache, the rate
    structures, the security telemetry, and the block action."""

    def __init__(self, conf, block_fn):
        """Build the per-daemon state from an already validated config."""
        self.conf = conf
        self.enforce = conf["ENFORCE"].lower() == "yes"
        self.ttl_base = int(conf["TTL"])
        self.ttl_max = int(conf["TTL_MAX"])
        self.rate_min_cap = int(conf["RATE_MIN"])
        self.rate_hour_cap = int(conf["RATE_HOUR"])
        self.optin, self.ignore, self.udp_ok = load_sids(conf["SIDS"])
        self.journal = Journal(conf["JOURNAL"])
        self.allow = AllowCache()
        self.block_fn = block_fn
        self.minute = collections.deque()  # timestamps of new-block attempts
        self.hour_seen = {}                # ip -> first counted ts in the hour
        self.capped_episode = False
        self.malformed = 0
        # security-event telemetry (design: monitoring chain 5g); flushed
        # at most every 15s so a burst does not turn into an fsync storm
        self.sec = {"resp_alerts_seen": 0, "resp_blocks_issued": 0,
                    "resp_dryrun_would_block": 0, "resp_last_alert_ts": 0,
                    "resp_last_action_ts": 0}
        self.sec_dirty = True
        self.sec_last_flush = 0.0

    def flush_sec(self):
        """Write the security-telemetry kv file, rate-limited to at most once every 15s to avoid an fsync storm."""
        if not self.sec_dirty or time.time() - self.sec_last_flush < 15:
            return
        try:
            os.makedirs(os.path.dirname(RESP_KV), exist_ok=True)
            with open(RESP_KV + ".tmp", "w") as f:
                for k, v in self.sec.items():
                    f.write(f"ng.{k}={v}\n")
            os.replace(RESP_KV + ".tmp", RESP_KV)
            self.sec_dirty = False
            self.sec_last_flush = time.time()
        except OSError:
            pass


def make_state(conf, block_fn=block_via_wrapper):
    """Build the responder's event state; the single construction point
    for the daemon and for tests, which pass their own block_fn."""
    return EventState(conf, block_fn)


def handle_event(line, st, now):
    """Drive one raw eve.json line through the seven gates and act on the
    outcome: a block, a dry-run WOULD BLOCK, a journal sighting, or a
    silent drop.
    INVARIANT: the gate list at the top of this file is the order of this
    function's body; changing one requires changing the other."""
    try:
        ev = json.loads(line)
    except json.JSONDecodeError:
        st.malformed += 1
        return
    if not isinstance(ev, dict) or ev.get("event_type") != "alert":
        st.flush_sec()
        return
    st.sec["resp_alerts_seen"] += 1
    st.sec["resp_last_alert_ts"] = int(now)
    st.sec_dirty = True
    st.flush_sec()
    alert = ev.get("alert") or {}
    flow = ev.get("flow") or {}
    if not isinstance(alert, dict):
        alert = {}
    if not isinstance(flow, dict):
        flow = {}
    sid = alert.get("signature_id", 0)
    sev = alert.get("severity", 255)
    sig = alert.get("signature", "?")
    src = ev.get("src_ip", "")
    dst = ev.get("dest_ip", "")
    proto = str(ev.get("proto", "")).upper()

    if sid in st.ignore:
        return
    if sev != 1 and sid not in st.optin:
        return

    tag = (f"sid={sid} sev={sev} src={src} dst={dst} "
           f"proto={proto} sig={sig!r}")

    # SAFETY: anti-spoofing gate - blocks require evidence of a real flow
    # (TCP bidirectional, or UDP/ICMP hand-promoted via sids.conf); a
    # single spoofed packet cannot trigger a block.
    if proto != "TCP" and sid not in st.udp_ok:
        log(f"WOULD BLOCK ({proto.lower() or 'unknown'}, "
            f"not eligible): {tag}")
        return
    if proto == "TCP":
        if (flow.get("pkts_toclient", 0) < 1
                or flow.get("pkts_toserver", 0) < 2):
            log(f"WOULD BLOCK (no bidirectional flow evidence): {tag}")
            return

    # direction and address class
    try:
        src_ip = ipaddress.ip_address(src)
        dst_ip = ipaddress.ip_address(dst)
    except ValueError:
        st.malformed += 1
        return
    if not any(dst_ip in n for n in st.conf["HOME_NETS"]
               if n.version == dst_ip.version):
        return  # not inbound
    if not src_ip.is_global:
        return

    prot = st.allow.protected(src)
    if prot is None:
        log(f"skip (allowlist undeterminable, failing toward "
            f"NOT blocking): {tag}")
        return
    if prot:
        log(f"skip (allowlisted/protected): {tag}")
        return

    rec = st.journal.data.get(src, {})
    if now < rec.get("blocked_until", 0):
        # Same offense: the kernel (or the shadow window) is already
        # covering it; refresh history only.
        st.journal.sighting(src, sid)
        return

    # rate caps on new-block attempts, identical in both modes
    while st.minute and st.minute[0] < now - 60:
        st.minute.popleft()
    for ip in [ip for ip, ts in st.hour_seen.items() if ts < now - 3600]:
        del st.hour_seen[ip]
    new_hour_entry = src not in st.hour_seen
    if (len(st.minute) >= st.rate_min_cap
            or (new_hour_entry and len(st.hour_seen) >= st.rate_hour_cap)):
        if not st.capped_episode:
            word = "RATE CAP" if st.enforce else "WOULD RATE-CAP"
            log(f"{word} hit ({len(st.minute)}/min, "
                f"{len(st.hour_seen)}/h distinct); suppressing new "
                f"blocks: {tag}")
            st.capped_episode = True
        st.journal.sighting(src, sid)
        return
    st.capped_episode = False
    st.minute.append(now)
    if new_hour_entry:
        st.hour_seen[src] = now

    ttl = min(st.ttl_base * (2 ** rec.get("count", 0)), st.ttl_max)
    offense_no = rec.get("count", 0) + 1

    if not st.enforce:
        st.journal.offense(src, sid, ttl, shadow=True)
        st.sec["resp_dryrun_would_block"] += 1
        st.sec["resp_last_action_ts"] = int(now)
        st.sec_dirty = True
        log(f"WOULD BLOCK: {tag} ttl={ttl} offense={offense_no}")
        return

    rc, err = st.block_fn(src, ttl)
    if rc == 0:
        st.journal.offense(src, sid, ttl, shadow=False)
        st.sec["resp_blocks_issued"] += 1
        st.sec["resp_last_action_ts"] = int(now)
        st.sec_dirty = True
        log(f"BLOCKED: {tag} ttl={ttl} offense={offense_no}")
    else:
        log(f"block FAILED ({err}): {tag}")


def main():
    """Tail eve.json forever and hand every line to handle_event, keeping the periodic housekeeping (prune, malformed reporting, sids reload, kv flush) around it; the responder's event loop."""
    conf = load_conf()
    st = make_state(conf)
    sids_mtime = 0
    try:
        sids_mtime = os.stat(conf["SIDS"]).st_mtime
    except FileNotFoundError:
        pass
    last_prune = time.time()
    last_malformed_report = time.time()

    log(f"responder: started, ENFORCE={'yes' if st.enforce else 'no'}, "
        f"{len(st.optin)} opt-in / {len(st.ignore)} ignored / "
        f"{len(st.udp_ok)} udp-ok SIDs")

    for line in follow(conf["EVE"]):
        if line is None:
            st.flush_sec()
            continue
        try:
            now = time.time()
            if now - last_prune > 86400:
                st.journal.prune()
                last_prune = now
            if st.malformed and now - last_malformed_report > 60:
                log(f"responder: {st.malformed} malformed/failed events "
                    "since last report")
                st.malformed = 0
                last_malformed_report = now
            try:
                mt = os.stat(conf["SIDS"]).st_mtime
                if mt != sids_mtime:
                    st.optin, st.ignore, st.udp_ok = load_sids(conf["SIDS"])
                    sids_mtime = mt
                    log(f"responder: sids.conf reloaded "
                        f"({len(st.optin)}/{len(st.ignore)}/"
                        f"{len(st.udp_ok)})")
            except FileNotFoundError:
                pass

            handle_event(line, st, now)
        except Exception as e:  # never let one event kill the tail
            st.malformed += 1
            if time.time() - last_malformed_report > 60:
                log(f"responder: event processing error: {e!r} "
                    f"({st.malformed} since last report)")
                st.malformed = 0
                last_malformed_report = time.time()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
