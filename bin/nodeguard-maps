#!/bin/bash
# nodeguard-maps: create/verify pinned maps, reconcile the allowlist, and
# set the live WireGuard port. ExecStart of nodeguard-maps.service.
set -uo pipefail
. /usr/local/lib/nodeguard/nodeguard-lib.sh
ng_env

# Persistent (NOT tmpfs): the last-good snapshots exist for boot-time
# generation, which is exactly when resolution races the network.
ALLOW_CACHE=/var/lib/nodeguard/allow-cache
ALLOW_KV="$NG_RUN/allow.kv"
FRESH="$NG_RUN/allow-fresh.txt"

# Directive outcomes for the kv export below: gen_fail is 1 when any
# dynamic directive could not be looked up this run or could not refresh
# its snapshot; gen_stale counts the directives served from their
# last-good snapshot.
gen_fail=0
gen_stale=0

mkdir -p "$NG_RUN" "$ALLOW_CACHE"

# A directive argument becomes a path element of the last-good cache, so
# reduce it to characters a filename carries safely.
cache_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# Fold one dynamic directive's fresh output into the generated allow file,
# keeping a per-directive last-good snapshot.
# SAFETY: reconcile-allow deletes every live allow entry the generated
# file omits, so one transient DNS or DERP failure would evict a protected
# remote from the live maps and make the management fallback path
# blockable (DERP rides TCP/443, which the kernel's UDP-only WireGuard
# pass does not cover). Serving the snapshot keeps the protection; an
# allow entry can only pass traffic, never drop it.
# NOTE: an empty result on a zero exit counts as a failure, since
# replacing a good snapshot with nothing is the eviction this cache
# exists to prevent.
allow_cache_fold() {
    local name="$1" fresh="$2" rc="$3"
    local cache="$ALLOW_CACHE/$name.txt"
    if [ "$rc" -eq 0 ] && [ -s "$fresh" ]; then
        cat "$fresh" >> "$GEN"
        # A full, read-only, or SELinux-denied /var/lib freezes the
        # snapshot at whatever it last held, and the next directive
        # failure would then serve arbitrarily old entries with nothing
        # in the kv saying so. Degraded, therefore, not silent.
        if ! { cp "$fresh" "$cache.tmp" && mv -f "$cache.tmp" "$cache"; }; then
            gen_fail=1
            ng_log "protected.conf: $name snapshot write failed; its last-good is now stale" warning
        fi
        return 0
    fi
    gen_fail=1
    if [ -s "$cache" ]; then
        cat "$cache" >> "$GEN"
        gen_stale=$((gen_stale + 1))
        ng_log "protected.conf: $name failed; using last-good ($(grep -c . "$cache") entries)" warning
    else
        ng_log "protected.conf: $name failed with no last-good snapshot; its entries are absent this run" warning
    fi
    return 1
}

# 1. Create missing maps / verify existing ones against the build-generated
#    spec. A mismatch fails here, loudly, with recovery instructions.
create_out=$(python3 "$NG_MAP" create-maps --spec "$NG_SPEC") || exit 2
printf '%s\n' "$create_out"
# SAFETY: created maps mean the old sweep cache describes maps that no
# longer exist (reboot); truncate so counts read visible-unknown until
# the first sweep, never confident pre-reboot totals.
if printf '%s' "$create_out" | grep -q "^CREATED"; then
    rm -f /var/lib/nodeguard/mapstat.kv /var/lib/nodeguard/sweep_hits.json
fi

# 2. Build the generated protected-remotes file from protected.conf.
GEN="$NG_RUN/allow-generated.txt"
: > "$GEN"

if [ -f /etc/nodeguard/protected.conf ]; then
    while read -r directive arg _ || [ -n "$directive" ]; do
        case "$directive" in
        ''|'#'*) ;;
        cidr)
            echo "$arg" >> "$GEN"
            ;;
        resolve)
            # Best effort snapshot of current A/AAAA records (the fleet
            # resolver is Quad9). Failure falls back to the last-good
            # snapshot, never to omitting the protection.
            python3 - "$arg" > "$FRESH" 2>/dev/null <<'PYEOF'
import socket, sys
seen = set()
for fam, _t, _p, _c, sa in socket.getaddrinfo(sys.argv[1], None):
    ip = sa[0]
    if ip not in seen:
        seen.add(ip)
        print(f"{ip}/32" if fam == socket.AF_INET else f"{ip}/128")
PYEOF
            rc=$?
            allow_cache_fold "resolve_$(cache_name "$arg")" "$FRESH" "$rc"
            ;;
        derp)
            derpjson="$NG_RUN/derp-map.json"
            : > "$FRESH"
            rc=1
            if tailscale debug derp-map > "$derpjson" 2>/dev/null; then
                python3 - "$derpjson" > "$FRESH" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
seen = set()
for region in data.get("Regions", {}).values():
    for node in region.get("Nodes") or []:
        for key, suffix in (("IPv4", "/32"), ("IPv6", "/128")):
            ip = node.get(key)
            if ip and not ip.startswith("none") and ip not in seen:
                seen.add(ip)
                print(ip + suffix)
PYEOF
                rc=$?
            else
                ng_log "protected.conf: derp-map fetch failed" warning
            fi
            allow_cache_fold derp "$FRESH" "$rc"
            ;;
        *)
            ng_log "protected.conf: unknown directive '$directive'" warning
            ;;
        esac
    done < /etc/nodeguard/protected.conf
fi

# 3. Host-specific dynamic WAN entries (node-2: default gateway, DHCP server,
#    own WAN address, each as /32 read live so a renumber cannot rot them).
if [ "${WAN_DYNAMIC_ALLOW:-no}" = "yes" ]; then
    gw=$(ip -4 route show default dev "$IFACE" 2>/dev/null | awk '{print $3; exit}')
    [ -n "$gw" ] && echo "$gw/32" >> "$GEN"
    lease=$(grep -hs '^SERVER_ADDRESS=' /var/lib/NetworkManager/*"$IFACE".lease 2>/dev/null | head -1 | cut -d= -f2)
    [ -n "$lease" ] && echo "$lease/32" >> "$GEN"
    own=$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}' | cut -d/ -f1)
    [ -n "$own" ] && echo "$own/32" >> "$GEN"
    if [ -z "$gw" ] || [ -z "$own" ]; then
        ng_log "WAN dynamic allow: gw='$gw' own='$own' (missing entries)" warning
    fi
fi

# 4. Reconcile allow maps to static files + generated entries.
#    SAFETY: refuses to proceed if the canary target appears in any allow
#    source (the watchdog's over-block probe must never be allowlisted).
reconcile_out=$(python3 "$NG_MAP" reconcile-allow \
    --static /etc/nodeguard/allow4.txt /etc/nodeguard/allow6.txt \
    --generated "$GEN" \
    --canary "${CANARY_IP:?CANARY_IP not set}") || exit 2
printf '%s\n' "$reconcile_out"

# 4b. Allow-generation state for the monitoring chain, written into the
# root-owned $NG_RUN rather than /run/zabbix, which the agent owns and a
# root writer therefore must not create files in.
# SAFETY: an entry count that could not be parsed is OMITTED, so its item
# goes unsupported rather than reading as an empty allowlist.
entries=$(printf '%s\n' "$reconcile_out" \
    | awk '/allow maps reconciled/ { print $(NF - 1) }')
{
    [ -n "$entries" ] && echo "ng.allow_entries=$entries"
    echo "ng.allow_gen_fail=$gen_fail"
    echo "ng.allow_gen_stale=$gen_stale"
    echo "ng.allow_reconcile_ts=$(date +%s)"
} > "$ALLOW_KV.tmp" && mv -f "$ALLOW_KV.tmp" "$ALLOW_KV"

# 5. Live WireGuard port into config[0]. Primary source is the socket
#    tailscaled actually bound; last resort is the tailscale default.
port=$(ng_live_wg_port)
src=ss
if [ -z "$port" ]; then
    port=41641
    src=default
fi
ng_cfg_set 0 "$port"
ng_log "config[0] wg port = $port (source: $src)"

# config[1] (kill switch) is deliberately NOT touched here for an existing
# map; ngmap.py create-maps initializes it to 0 only on first creation.
exit 0
